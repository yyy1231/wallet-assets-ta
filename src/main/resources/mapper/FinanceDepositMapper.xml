<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novax.mapper.FinanceDepositMapper">

    <resultMap id="BaseResultMap" type="com.novax.entity.mysql.FinanceDepositEntity">
        <result column="user_id" property="userId"/>
        <result column="currency" property="currency"/>
        <result column="amount" property="amount"/>
    </resultMap>

    <select id="selectActiveDepositsByUserId" resultMap="BaseResultMap">
        SELECT user_id, currency, amount
        FROM superex_finance.deposit
        WHERE user_id = #{userId} AND state IN (1,2)
    </select>

</mapper>
