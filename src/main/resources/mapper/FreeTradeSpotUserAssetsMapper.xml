<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novax.mapper.FreeTradeSpotUserAssetsMapper">

    <resultMap id="BaseResultMap" type="com.novax.entity.mysql.FreeTradeSpotUserAssetsEntity">
        <result column="user_id" property="userId"/>
        <result column="currency" property="currency"/>
        <result column="currency_id" property="currencyId"/>
        <result column="available" property="available"/>
        <result column="frozen" property="frozen"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT user_id, currency, currency_id, available, frozen
        FROM superex_free_trade.spot_user_assets
        WHERE user_id = #{userId}
    </select>

</mapper>
